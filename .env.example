# Discord Bot — required to run
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=your-server-id-here

# Role IDs (Discord → User Settings → Advanced → Developer Mode → right-click role → Copy Role ID)
POKEMON_TRAINER_ROLE_ID=000000000000000000
POKEMON_HUNTER_ROLE_ID=000000000000000000
# Required for rules check mark → Hunting Noob
HUNTING_NOOB_ROLE_ID=000000000000000000
ADMIN_ROLE_ID=000000000000000000
MOD_ROLE_ID=000000000000000000

# Optional / already defaulted in bot.py
# Staff review role — can run !pingreport
PROFESSOR_OAK_ROLE_ID=1539123032847687730
# User to ping on unauthorized staff commands
AZTEK_USER_ID=638486065430265877

# Channel IDs
# Defaults already in bot.py:
# ANNOUNCEMENTS_CHANNEL_ID=1502087476305461349
# GETROLES_CHANNEL_ID=1502144792358817933
ANNOUNCEMENTS_CHANNEL_ID=1502087476305461349
GETROLES_CHANNEL_ID=1502144792358817933

# Rules check mark → Pokemon Trainer + Hunting Noob (until Hunter)
RULES_CHANNEL_ID=1496203694994227313
RULES_MESSAGE_ID=1542167722752876704

# Optional (name-based capture still works without these)
GENERAL_CHAT_CHANNEL_ID=0
OPEN_HUNTING_CHANNEL_ID=0
MOD_CHAT_CHANNEL_ID=0
PULLS_CHANNEL_ID=0
SUCCESS_CHANNEL_ID=0

# Optional: MEE6 role sync
MEE6_SILVER_ROLE_ID=0
